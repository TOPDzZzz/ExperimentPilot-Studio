# ExperimentPilot 配置文件
# 复制此文件为 .env 并填入你的 API 配置

# OpenAI API Key
OPENAI_API_KEY=your_api_key_here

# API Base URL (支持 OpenAI / SiliconFlow / 本地模型)
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称
MODEL_NAME=gpt-4o-mini

# 最大输出 Token 数
MAX_TOKENS=800

# 速率限制 (RPM)
RPM_LIMIT=60

# 允许危险 Shell 命令 (true/false)
ALLOW_SHELL=false
